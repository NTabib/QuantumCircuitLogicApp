{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "shots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "description": "Shots per circuit evaluation (default 100)."
              }
            }
          }
        }
      }
    },
    "actions": {
      "Algorithm": {
        "type": "Scope",
        "runAfter": {},
        "actions": {
          "Create_circuit": {
            "type": "ServiceProvider",
            "runAfter": {},
            "inputs": {
              "parameters": {
                "initialState": "00"
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "createCircuit",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "01_H_q0": {
            "type": "ServiceProvider",
            "runAfter": {
              "Create_circuit": [
                "Succeeded"
              ]
            },
            "inputs": {
              "parameters": {
                "circuit": "@body('Create_circuit')?['circuit']",
                "target": 0
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addHadamard",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "02_CNOT_q1": {
            "type": "ServiceProvider",
            "runAfter": {
              "01_H_q0": [
                "Succeeded"
              ]
            },
            "inputs": {
              "parameters": {
                "circuit": "@body('01_H_q0')?['circuit']",
                "target": 1,
                "control": 0
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addCnot",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "03_X_q0": {
            "type": "ServiceProvider",
            "runAfter": {
              "02_CNOT_q1": [
                "Succeeded"
              ]
            },
            "inputs": {
              "parameters": {
                "circuit": "@body('02_CNOT_q1')?['circuit']",
                "target": 0
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addX",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "04_Z_q0": {
            "type": "ServiceProvider",
            "runAfter": {
              "03_X_q0": [
                "Succeeded"
              ]
            },
            "inputs": {
              "parameters": {
                "circuit": "@body('03_X_q0')?['circuit']",
                "target": 0
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addZ",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "05_CNOT_q1": {
            "type": "ServiceProvider",
            "runAfter": {
              "04_Z_q0": [
                "Succeeded"
              ]
            },
            "inputs": {
              "parameters": {
                "circuit": "@body('04_Z_q0')?['circuit']",
                "target": 1,
                "control": 0
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addCnot",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "06_H_q0": {
            "type": "ServiceProvider",
            "runAfter": {
              "05_CNOT_q1": [
                "Succeeded"
              ]
            },
            "inputs": {
              "parameters": {
                "circuit": "@body('05_CNOT_q1')?['circuit']",
                "target": 0
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addHadamard",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "Execute_circuit": {
            "type": "ServiceProvider",
            "runAfter": {
              "06_H_q0": [
                "Succeeded"
              ]
            },
            "inputs": {
              "parameters": {
                "initialState": "@body('06_H_q0')?['circuit']?['initialState']",
                "gates": "@body('06_H_q0')?['circuit']?['gates']",
                "shots": "@coalesce(triggerBody()?['shots'], 100)"
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuit",
                "operationId": "runCircuit",
                "serviceProviderId": "/serviceProviders/quantumCircuit"
              }
            }
          }
        }
      },
      "Success_response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {
          "Algorithm": [
            "Succeeded"
          ]
        },
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "workflowRunId": "@workflow()?['run']?['name']",
            "algorithm": "SuperdenseCoding",
            "demo": "Encode fixed message 11 using X and Z on Alice's qubit, then decode with CNOT and H.",
            "circuit": "@body('06_H_q0')?['circuit']",
            "circuitResult": "@body('Execute_circuit')",
            "sentMessage": "11",
            "decodedMessage": "@body('Execute_circuit')?['sample']"
          }
        }
      },
      "Failure_response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {
          "Algorithm": [
            "Failed",
            "TimedOut"
          ]
        },
        "inputs": {
          "statusCode": 400,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "error": "SuperdenseCoding demonstration failed.",
            "details": "@result('Algorithm')"
          }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
