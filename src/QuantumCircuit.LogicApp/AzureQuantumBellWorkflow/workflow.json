{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "shots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "description": "Requested quantum hardware shots (default 100)."
              }
            }
          }
        }
      }
    },
    "actions": {
      "Build_and_submit": {
        "type": "Scope",
        "runAfter": {},
        "actions": {
          "Create_circuit": {
            "type": "ServiceProvider",
            "runAfter": {},
            "inputs": {
              "parameters": {
                "initialState": "00"
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "createCircuit",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "Prepare_superposition": {
            "type": "ServiceProvider",
            "runAfter": {
              "Create_circuit": [ "Succeeded" ]
            },
            "inputs": {
              "parameters": {
                "circuit": "@body('Create_circuit')?['circuit']",
                "target": 0
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addHadamard",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "Entangle_qubits": {
            "type": "ServiceProvider",
            "runAfter": {
              "Prepare_superposition": [ "Succeeded" ]
            },
            "inputs": {
              "parameters": {
                "circuit": "@body('Prepare_superposition')?['circuit']",
                "control": 0,
                "target": 1
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addCnot",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "Run_on_Azure_Quantum": {
            "type": "ServiceProvider",
            "runAfter": {
              "Entangle_qubits": [ "Succeeded" ]
            },
            "retryPolicy": {
              "type": "none"
            },
            "inputs": {
              "parameters": {
                "initialState": "@body('Entangle_qubits')?['circuit']?['initialState']",
                "gates": "@body('Entangle_qubits')?['circuit']?['gates']",
                "shots": "@coalesce(triggerBody()?['shots'], 100)"
              },
              "serviceProviderConfiguration": {
                "connectionName": "azureQuantumCircuit",
                "operationId": "runCircuit",
                "serviceProviderId": "/serviceProviders/azureQuantumCircuit"
              }
            }
          }
        }
      },
      "Success_response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {
          "Build_and_submit": [ "Succeeded" ]
        },
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "workflowRunId": "@workflow()?['run']?['name']",
            "algorithm": "AzureQuantumBell",
            "description": "H(0), CNOT(0,1); the Azure Quantum backend submits this circuit as Quil to the configured Rigetti target and waits for its job.",
            "circuit": "@body('Entangle_qubits')?['circuit']",
            "quantumJob": "@body('Run_on_Azure_Quantum')"
          }
        }
      },
      "Failure_response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {
          "Build_and_submit": [ "Failed", "TimedOut" ]
        },
        "inputs": {
          "statusCode": 502,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "error": "Azure Quantum job execution failed.",
            "details": "@result('Build_and_submit')"
          }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
