{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "shots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "description": "Shots per circuit evaluation (default 100)."
              }
            }
          }
        }
      }
    },
    "actions": {
      "Initialize_search": {
        "type": "InitializeVariable",
        "runAfter": {},
        "inputs": {
          "variables": [
            {
              "name": "BestScore",
              "type": "float",
              "value": -1
            },
            {
              "name": "BestParameters",
              "type": "object",
              "value": {}
            },
            {
              "name": "BestCounts",
              "type": "object",
              "value": {}
            },
            {
              "name": "Evaluations",
              "type": "array",
              "value": []
            }
          ]
        }
      },
      "Algorithm": {
        "type": "Scope",
        "runAfter": {
          "Initialize_search": [
            "Succeeded"
          ]
        },
        "actions": {
          "Parameter_sweep": {
            "type": "Foreach",
            "runAfter": {},
            "foreach": [
              {
                "gamma": 0,
                "beta": 0
              },
              {
                "gamma": 1.5707963267948966,
                "beta": 0
              },
              {
                "gamma": 1.5707963267948966,
                "beta": 0.39269908169872414
              }
            ],
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 1
              }
            },
            "actions": {
              "Create_circuit": {
                "type": "ServiceProvider",
                "runAfter": {},
                "inputs": {
                  "parameters": {
                    "initialState": "00"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuitBuilder",
                    "operationId": "createCircuit",
                    "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
                  }
                }
              },
              "01_H_q0": {
                "type": "ServiceProvider",
                "runAfter": {
                  "Create_circuit": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "circuit": "@body('Create_circuit')?['circuit']",
                    "target": 0
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuitBuilder",
                    "operationId": "addHadamard",
                    "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
                  }
                }
              },
              "02_H_q1": {
                "type": "ServiceProvider",
                "runAfter": {
                  "01_H_q0": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "circuit": "@body('01_H_q0')?['circuit']",
                    "target": 1
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuitBuilder",
                    "operationId": "addHadamard",
                    "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
                  }
                }
              },
              "03_CNOT_q1": {
                "type": "ServiceProvider",
                "runAfter": {
                  "02_H_q1": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "circuit": "@body('02_H_q1')?['circuit']",
                    "target": 1,
                    "control": 0
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuitBuilder",
                    "operationId": "addCnot",
                    "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
                  }
                }
              },
              "04_RZ_q1": {
                "type": "ServiceProvider",
                "runAfter": {
                  "03_CNOT_q1": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "circuit": "@body('03_CNOT_q1')?['circuit']",
                    "target": 1,
                    "angle": "@mul(-1.0,items('Parameter_sweep')?['gamma'])"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuitBuilder",
                    "operationId": "addRz",
                    "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
                  }
                }
              },
              "05_CNOT_q1": {
                "type": "ServiceProvider",
                "runAfter": {
                  "04_RZ_q1": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "circuit": "@body('04_RZ_q1')?['circuit']",
                    "target": 1,
                    "control": 0
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuitBuilder",
                    "operationId": "addCnot",
                    "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
                  }
                }
              },
              "06_RX_q0": {
                "type": "ServiceProvider",
                "runAfter": {
                  "05_CNOT_q1": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "circuit": "@body('05_CNOT_q1')?['circuit']",
                    "target": 0,
                    "angle": "@mul(2.0,items('Parameter_sweep')?['beta'])"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuitBuilder",
                    "operationId": "addRx",
                    "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
                  }
                }
              },
              "07_RX_q1": {
                "type": "ServiceProvider",
                "runAfter": {
                  "06_RX_q0": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "circuit": "@body('06_RX_q0')?['circuit']",
                    "target": 1,
                    "angle": "@mul(2.0,items('Parameter_sweep')?['beta'])"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuitBuilder",
                    "operationId": "addRx",
                    "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
                  }
                }
              },
              "Execute_circuit": {
                "type": "ServiceProvider",
                "runAfter": {
                  "07_RX_q1": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "initialState": "@body('07_RX_q1')?['circuit']?['initialState']",
                    "gates": "@body('07_RX_q1')?['circuit']?['gates']",
                    "shots": "@coalesce(triggerBody()?['shots'], 100)"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuit",
                    "operationId": "runCircuit",
                    "serviceProviderId": "/serviceProviders/quantumCircuit"
                  }
                }
              },
              "Objective": {
                "type": "Compose",
                "runAfter": {
                  "Execute_circuit": [
                    "Succeeded"
                  ]
                },
                "inputs": "@div(float(add(coalesce(body('Execute_circuit')?['counts']?['01'],0),coalesce(body('Execute_circuit')?['counts']?['10'],0))),float(body('Execute_circuit')?['shots']))"
              },
              "Update_best": {
                "type": "If",
                "runAfter": {
                  "Objective": [
                    "Succeeded"
                  ]
                },
                "expression": "@greater(outputs('Objective'),variables('BestScore'))",
                "actions": {
                  "Set_best_score": {
                    "type": "SetVariable",
                    "runAfter": {},
                    "inputs": {
                      "name": "BestScore",
                      "value": "@outputs('Objective')"
                    }
                  },
                  "Set_best_parameters": {
                    "type": "SetVariable",
                    "runAfter": {
                      "Set_best_score": [
                        "Succeeded"
                      ]
                    },
                    "inputs": {
                      "name": "BestParameters",
                      "value": "@items('Parameter_sweep')"
                    }
                  },
                  "Set_best_counts": {
                    "type": "SetVariable",
                    "runAfter": {
                      "Set_best_parameters": [
                        "Succeeded"
                      ]
                    },
                    "inputs": {
                      "name": "BestCounts",
                      "value": "@body('Execute_circuit')?['counts']"
                    }
                  }
                },
                "else": {
                  "actions": {}
                }
              },
              "Record_evaluation": {
                "type": "AppendToArrayVariable",
                "runAfter": {
                  "Update_best": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "name": "Evaluations",
                  "value": {
                    "parameters": "@items('Parameter_sweep')",
                    "objective": "@outputs('Objective')",
                    "circuit": "@body('07_RX_q1')?['circuit']",
                    "circuitResult": "@body('Execute_circuit')"
                  }
                }
              }
            }
          }
        }
      },
      "Success_response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {
          "Algorithm": [
            "Succeeded"
          ]
        },
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "workflowRunId": "@workflow()?['run']?['name']",
            "algorithm": "Qaoa",
            "demo": "Depth-one QAOA for two-vertex MaxCut. A sequential classical grid search maximizes the measured probability of differing bits.",
            "bestObjective": "@variables('BestScore')",
            "bestParameters": "@variables('BestParameters')",
            "bestCounts": "@variables('BestCounts')",
            "evaluations": "@variables('Evaluations')"
          }
        }
      },
      "Failure_response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {
          "Algorithm": [
            "Failed",
            "TimedOut"
          ]
        },
        "inputs": {
          "statusCode": 400,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "error": "Qaoa demonstration failed.",
            "details": "@result('Algorithm')"
          }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
