{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "shots": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "Complete-circuit executions; defaults to 100." }
            }
          }
        }
      }
    },
    "actions": {
      "Lesson": {
        "type": "Scope",
        "runAfter": {},
        "actions": {
          "Create_circuit": {
            "type": "ServiceProvider",
            "runAfter": {},
            "inputs": {
              "parameters": { "initialState": "0" },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "createCircuit",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "01_Hadamard": {
            "type": "ServiceProvider",
            "runAfter": { "Create_circuit": [ "Succeeded" ] },
            "inputs": {
              "parameters": { "circuit": "@body('Create_circuit')?['circuit']", "target": 0 },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addHadamard",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "02_Phase_Z": {
            "type": "ServiceProvider",
            "runAfter": { "01_Hadamard": [ "Succeeded" ] },
            "inputs": {
              "parameters": { "circuit": "@body('01_Hadamard')?['circuit']", "target": 0 },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addZ",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "03_Hadamard": {
            "type": "ServiceProvider",
            "runAfter": { "02_Phase_Z": [ "Succeeded" ] },
            "inputs": {
              "parameters": { "circuit": "@body('02_Phase_Z')?['circuit']", "target": 0 },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuitBuilder",
                "operationId": "addHadamard",
                "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
              }
            }
          },
          "Execute_circuit": {
            "type": "ServiceProvider",
            "runAfter": { "03_Hadamard": [ "Succeeded" ] },
            "inputs": {
              "parameters": {
                "initialState": "@body('03_Hadamard')?['circuit']?['initialState']",
                "gates": "@body('03_Hadamard')?['circuit']?['gates']",
                "shots": "@coalesce(triggerBody()?['shots'], 100)"
              },
              "serviceProviderConfiguration": {
                "connectionName": "quantumCircuit",
                "operationId": "runCircuit",
                "serviceProviderId": "/serviceProviders/quantumCircuit"
              }
            }
          }
        }
      },
      "Success_response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": { "Lesson": [ "Succeeded" ] },
        "inputs": {
          "statusCode": 200,
          "headers": { "Content-Type": "application/json" },
          "body": {
            "lesson": { "id": "PhaseInterference", "title": "A phase becomes visible through interference", "concept": "Z changes the relative phase between |0> and |1>. H-Z-H converts that relative phase into a measurable bit flip.", "expected": "The sequence H -> Z -> H maps |0> deterministically to |1>." },
            "circuit": "@body('03_Hadamard')?['circuit']",
            "circuitResult": "@body('Execute_circuit')"
          }
        }
      },
      "Failure_response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": { "Lesson": [ "Failed", "TimedOut" ] },
        "inputs": {
          "statusCode": 400,
          "headers": { "Content-Type": "application/json" },
          "body": { "lesson": "PhaseInterference", "error": "The phase/interference lesson failed.", "details": "@result('Lesson')" }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
