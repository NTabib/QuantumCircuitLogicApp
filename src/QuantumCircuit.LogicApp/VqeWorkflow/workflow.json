{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "shots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "description": "Shots per circuit evaluation (default 100)."
              }
            }
          }
        }
      }
    },
    "actions": {
      "Initialize_search": {
        "type": "InitializeVariable",
        "runAfter": {},
        "inputs": {
          "variables": [
            {
              "name": "BestScore",
              "type": "float",
              "value": 2
            },
            {
              "name": "BestParameters",
              "type": "object",
              "value": {}
            },
            {
              "name": "BestCounts",
              "type": "object",
              "value": {}
            },
            {
              "name": "Evaluations",
              "type": "array",
              "value": []
            }
          ]
        }
      },
      "Algorithm": {
        "type": "Scope",
        "runAfter": {
          "Initialize_search": [
            "Succeeded"
          ]
        },
        "actions": {
          "Parameter_sweep": {
            "type": "Foreach",
            "runAfter": {},
            "foreach": [
              {
                "theta": 0
              },
              {
                "theta": 1.5707963267948966
              },
              {
                "theta": 3.141592653589793
              }
            ],
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 1
              }
            },
            "actions": {
              "Create_circuit": {
                "type": "ServiceProvider",
                "runAfter": {},
                "inputs": {
                  "parameters": {
                    "initialState": "0"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuitBuilder",
                    "operationId": "createCircuit",
                    "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
                  }
                }
              },
              "01_RY_q0": {
                "type": "ServiceProvider",
                "runAfter": {
                  "Create_circuit": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "circuit": "@body('Create_circuit')?['circuit']",
                    "target": 0,
                    "angle": "@items('Parameter_sweep')?['theta']"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuitBuilder",
                    "operationId": "addRy",
                    "serviceProviderId": "/serviceProviders/quantumCircuitBuilder"
                  }
                }
              },
              "Execute_circuit": {
                "type": "ServiceProvider",
                "runAfter": {
                  "01_RY_q0": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "initialState": "@body('01_RY_q0')?['circuit']?['initialState']",
                    "gates": "@body('01_RY_q0')?['circuit']?['gates']",
                    "shots": "@coalesce(triggerBody()?['shots'], 100)"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "quantumCircuit",
                    "operationId": "runCircuit",
                    "serviceProviderId": "/serviceProviders/quantumCircuit"
                  }
                }
              },
              "Objective": {
                "type": "Compose",
                "runAfter": {
                  "Execute_circuit": [
                    "Succeeded"
                  ]
                },
                "inputs": "@div(float(sub(coalesce(body('Execute_circuit')?['counts']?['0'],0),coalesce(body('Execute_circuit')?['counts']?['1'],0))),float(body('Execute_circuit')?['shots']))"
              },
              "Update_best": {
                "type": "If",
                "runAfter": {
                  "Objective": [
                    "Succeeded"
                  ]
                },
                "expression": "@less(outputs('Objective'),variables('BestScore'))",
                "actions": {
                  "Set_best_score": {
                    "type": "SetVariable",
                    "runAfter": {},
                    "inputs": {
                      "name": "BestScore",
                      "value": "@outputs('Objective')"
                    }
                  },
                  "Set_best_parameters": {
                    "type": "SetVariable",
                    "runAfter": {
                      "Set_best_score": [
                        "Succeeded"
                      ]
                    },
                    "inputs": {
                      "name": "BestParameters",
                      "value": "@items('Parameter_sweep')"
                    }
                  },
                  "Set_best_counts": {
                    "type": "SetVariable",
                    "runAfter": {
                      "Set_best_parameters": [
                        "Succeeded"
                      ]
                    },
                    "inputs": {
                      "name": "BestCounts",
                      "value": "@body('Execute_circuit')?['counts']"
                    }
                  }
                },
                "else": {
                  "actions": {}
                }
              },
              "Record_evaluation": {
                "type": "AppendToArrayVariable",
                "runAfter": {
                  "Update_best": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "name": "Evaluations",
                  "value": {
                    "parameters": "@items('Parameter_sweep')",
                    "objective": "@outputs('Objective')",
                    "circuit": "@body('01_RY_q0')?['circuit']",
                    "circuitResult": "@body('Execute_circuit')"
                  }
                }
              }
            }
          }
        }
      },
      "Success_response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {
          "Algorithm": [
            "Succeeded"
          ]
        },
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "workflowRunId": "@workflow()?['run']?['name']",
            "algorithm": "Vqe",
            "demo": "Single-qubit VQE for Hamiltonian Z using Ry(theta)|0>. A sequential classical grid search minimizes measured energy; exact ground energy is -1.",
            "bestObjective": "@variables('BestScore')",
            "bestParameters": "@variables('BestParameters')",
            "bestCounts": "@variables('BestCounts')",
            "evaluations": "@variables('Evaluations')"
          }
        }
      },
      "Failure_response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {
          "Algorithm": [
            "Failed",
            "TimedOut"
          ]
        },
        "inputs": {
          "statusCode": 400,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "error": "Vqe demonstration failed.",
            "details": "@result('Algorithm')"
          }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
